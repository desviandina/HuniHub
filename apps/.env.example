# Salin file ini menjadi .env lalu isi nilai sesuai config Firebase + Google Maps kamu.
# Expo otomatis membaca file .env untuk variabel berawalan EXPO_PUBLIC_.
# JANGAN commit .env ke repository.

# Config Web App dari Firebase Console -> Project settings -> General
# Buat project baru di https://console.firebase.google.com lalu:
# 1. Enable Authentication: Email/Password + Google
# 2. Enable Firestore Database
# 3. Enable Storage (untuk foto hunian)
EXPO_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_FIREBASE_AUTH_DOMAIN
EXPO_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID

# API key Google Maps untuk react-native-maps (Android).
# Juga harus diisi ke apps/app.json -> expo.android.config.googleMaps.apiKey
# sebelum build APK.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY

# Web client ID dari Google Cloud Console (untuk login Google/Google Sign-In).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID